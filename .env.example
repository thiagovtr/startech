# Variáveis do Docker Compose (copie para `.env`, que é ignorado pelo git: `cp .env.example .env`).
# Os valores abaixo são apenas para desenvolvimento local. Em qualquer outro ambiente, troque-os;
# no Kubernetes, estes valores vêm de Secret (nunca de ConfigMap nem da imagem).

# PostgreSQL do ms-hemocentros (usuário `hemocentros`, banco `hemocentros`)
HEMOCENTROS_DB_PASSWORD=hemocentros

# RabbitMQ (usuário/senha do broker, usados pelo ms-hemocentros para publicar e consumir)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
