# Variáveis do Docker Compose (copie para `.env`, que é ignorado pelo git: `cp .env.example .env`).
# Os valores abaixo são apenas para desenvolvimento local. Em qualquer outro ambiente, troque-os;
# no Kubernetes, estes valores vêm de Secret (nunca de ConfigMap nem da imagem).

# PostgreSQL do ms-hemocentros (usuário `hemocentros`, banco `hemocentros`)
HEMOCENTROS_DB_PASSWORD=hemocentros

# PostgreSQL do ms-orquestrador (usuário `orquestrador`, banco `orquestrador`)
ORQUESTRADOR_DB_PASSWORD=orquestrador

# PostgreSQL do ms-comunicacao (usuário `comunicacao`, banco `comunicacao`)
COMUNICACAO_DB_PASSWORD=comunicacao

# RabbitMQ (usuário/senha do broker, usados pelo ms-hemocentros para publicar e consumir)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Keycloak e PostgreSQL do Keycloak (identidade OIDC e emissão de JWT RS256)
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Ollama (LLM local do ms-rag). Modelos baixados uma vez pelo serviço `ollama-pull` para o volume.
OLLAMA_MODELO_CHAT=qwen2.5:1.5b
OLLAMA_MODELO_EMBEDDINGS=nomic-embed-text
OLLAMA_MEM_LIMIT=4g
OLLAMA_KEEP_ALIVE=30m
