# No iPhone físico, use o IP local do MacBook, não localhost.
# Exemplo: EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080

# Keycloak acessível pelo celular (IP local ou IP público da VPS).
EXPO_PUBLIC_KEYCLOAK_URL=http://192.168.1.10:8089
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=mobile

# Opcional (necessário no Android via Expo Go caso o app gere startech:// em vez de exp://):
# EXPO_PUBLIC_REDIRECT_URI=exp://192.168.1.10:8081/--/autenticacao
