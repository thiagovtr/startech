{
  "id": "startech",
  "realm": "startech",
  "displayName": "StarTech",
  "displayNameHtml": "<strong>StarTech</strong> — Doação de Sangue",
  "loginTheme": "startech",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR",
    "en"
  ],
  "defaultLocale": "pt-BR",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "defaultSignatureAlgorithm": "RS256",
  "defaultRole": {
    "name": "default-roles-startech",
    "description": "Papeis padrao atribuidos automaticamente a novos doadores cadastrados",
    "composite": true,
    "clientRole": false
  },
  "roles": {
    "realm": [
      {
        "name": "doador",
        "description": "Doador de sangue autenticado no aplicativo movel (acesso ao BFF Mobile)",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "operador",
        "description": "Operador/gestor de hemocentro autenticado no painel administrativo (acesso ao BFF Web)",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-startech",
        "description": "Papeis padrao atribuidos automaticamente a novos doadores cadastrados",
        "composite": true,
        "composites": {
          "realm": [
            "doador"
          ]
        },
        "clientRole": false
      }
    ]
  },
  "clientScopes": [
    {
      "name": "startech-roles-thin",
      "description": "Thin Token: inclui apenas o identificador opaco (sub) e os papeis do realm (realm_access.roles), sem expor dados pessoais sensiveis (LGPD)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "subject-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "email-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "startech:mobile",
      "description": "Escopo exclusivo do aplicativo movel de doadores — injeta audience (aud = bff-mobile)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-bff-mobile",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "bff-mobile",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "startech:web",
      "description": "Escopo exclusivo do painel web dos hemocentros — injeta audience (aud = bff-web)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-bff-web",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "bff-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "startech-mobile",
      "name": "StarTech App Mobile (Doadores)",
      "description": "Cliente OIDC publico com Authorization Code + PKCE (S256) para o app React Native / Expo",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "exp://*",
        "startech://*",
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "startech-roles-thin",
        "startech:mobile"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "startech-web",
      "name": "StarTech Painel Web (Hemocentros)",
      "description": "Cliente OIDC publico com Authorization Code + PKCE (S256) para o painel React dos hemocentros",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "http://localhost:8085/*",
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "http://localhost:8085",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "startech-roles-thin",
        "startech:web"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "mobile",
      "name": "StarTech App Mobile (Alias de compatibilidade)",
      "description": "Cliente OIDC publico de compatibilidade para scripts E2E e configuracoes legadas do app mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "exp://*",
        "startech://*",
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "startech-roles-thin",
        "startech:mobile"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "web",
      "name": "StarTech Painel Web (Alias de compatibilidade)",
      "description": "Cliente OIDC publico de compatibilidade para scripts E2E e configuracoes legadas do painel web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "http://localhost:8085/*",
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "http://localhost:8085",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "startech-roles-thin",
        "startech:web"
      ],
      "optionalClientScopes": []
    }
  ],
  "scopeMappings": [
    {
      "client": "startech-mobile",
      "roles": [
        "doador"
      ]
    },
    {
      "client": "startech-web",
      "roles": [
        "operador"
      ]
    },
    {
      "client": "mobile",
      "roles": [
        "doador"
      ]
    },
    {
      "client": "web",
      "roles": [
        "operador"
      ]
    }
  ],
  "users": [
